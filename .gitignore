# Local Cloudflare/Wrangler state: local D1 database (user records), caches, build output
.wrangler/
.dev.vars

# Python
__pycache__/
*.pyc

# Audio and other large media never go in git (see docs/archive_structure.md)
*.wav
*.WAV
*.opus
*.flac
*.mp3
*.m4a

# Ingest manifests can contain private recording locations
ingest_manifest*.csv

# Editor / OS clutter
.DS_Store
Thumbs.db
*.swp

# The master metadata lives on the archive drive (SOUNDSCAPE_METADATA_DIR),
# never in this public repository. Only empty templates are tracked.
/metadata/

# Local preview data (scripts/preview_site.py): may hold unpublished hours
.preview/

# Map tiles built by scripts/build_map_tiles.py (uploaded to R2, not kept in git)
.maptiles/

# Caches of downloaded data (scripts/fetch_weather.py)
.cache/

# Social-media videos and captions (scripts/make_social_post.py)
/social/
