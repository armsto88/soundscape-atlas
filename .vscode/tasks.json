{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview website (static, no accounts)",
      "detail": "http://localhost:8787 - map and player only; sign-in needs the Wrangler task",
      "type": "shell",
      "command": "python3 -m http.server 8787 --bind 127.0.0.1 --directory website",
      "windows": {
        "command": "py -3 -m http.server 8787 --bind 127.0.0.1 --directory website"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Preview website with accounts (wrangler pages dev)",
      "detail": "http://localhost:8788 - runs the Pages Functions against the local D1 database",
      "type": "shell",
      "command": "npx wrangler pages dev website",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Validate metadata and rebuild website data",
      "type": "shell",
      "command": "python3 scripts/validate_metadata.py && python3 scripts/build_web_metadata.py",
      "windows": {
        "command": "py -3 scripts/validate_metadata.py; if ($?) { py -3 scripts/build_web_metadata.py }"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
